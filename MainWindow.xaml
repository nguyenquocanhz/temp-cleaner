<Window x:Class="TempCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TempCleaner"
        Title="Temp Cleaner · Dọn file tạm" Width="1060" Height="820" MinWidth="860" MinHeight="580"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource BgBrush}">
    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="24,18,24,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AdminBadge" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="AdminText" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Button x:Name="RunAsAdminButton" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                        Click="RunAsAdmin_Click" ToolTip="Mở lại app với quyền admin (Windows sẽ hỏi UAC)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7EF;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Chạy lại bằng quyền admin"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/logo-256.png" Width="44" Height="44" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Temp Cleaner" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="by"/> <Run Text="WrenEvil.tech" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/> <Run Text="&amp;"/> <Run Text="nguyenquocanhz" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/> <Run Text="(nqatech)"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Tìm và dọn file tạm để giải phóng ổ cứng. Không xoá gì cho tới khi bạn bấm nút."
                               Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Ổ đĩa -->
        <ItemsControl Grid.Row="1" x:Name="DriveList" Margin="24,4,24,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DriveVm}">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,6" Width="188">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Label}"/>
                                <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}"/>
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,7,0,6" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                         BorderThickness="0" Background="{StaticResource LineBrush}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Low}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding FreeText}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" x:Name="Tabs" Margin="24,0,24,20">
            <!-- ============ Tab 1: Dọn file tạm ============ -->
            <TabItem Header="Dọn file tạm">
                <Grid Margin="0,10,0,0" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Quét lại"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click" Content="Chọn hết"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="SelectNone_Click" Content="Bỏ chọn"/>
                        <CheckBox x:Name="AgeFilterBox" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                  Checked="AgeFilter_Changed" Unchecked="AgeFilter_Changed"
                                  Content="Giữ lại file sửa trong 24 giờ qua (Temp, Claude)"
                                  ToolTip="An toàn cho chương trình và session Claude Code đang chạy"/>
                        <TextBlock x:Name="ScanStatus" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CategoryList" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CleanCategory}">
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChecked}"
                                                          IsEnabled="{Binding CheckEnabled}"/>
                                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Margin="10,0,12,0"
                                                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="16"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding PathHint}" FontFamily="Consolas" FontSize="11"
                                                               Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" CornerRadius="10" Padding="9,3" Margin="12,0"
                                                        VerticalAlignment="Center" MaxWidth="290">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="None">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warn">
                                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                                                                    <Setter Property="Background" Value="{StaticResource OkBgBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Warn">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SizeText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                        <DockPanel>
                            <Button x:Name="CleanButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                                    Click="Clean_Click" IsEnabled="False" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dọn các nhóm đã chọn"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionText" FontSize="15" FontWeight="SemiBold" Text="Chưa chọn nhóm nào"/>
                                <TextBlock x:Name="ResultText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0"
                                           Text="Tick các nhóm muốn dọn. File đang bị khoá sẽ được bỏ qua."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 2: Tìm file lớn ============ -->
            <TabItem Header="Tìm file lớn">
                <Grid Margin="0,10,0,0" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Text="Quét:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="BigRootBox" Width="150" IsEditable="True" VerticalAlignment="Center" Padding="6,5"/>
                        <TextBlock Text="Lớn hơn:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <TextBox x:Name="BigMinBox" Width="64" Text="500" VerticalAlignment="Center" Padding="4,5"
                                 HorizontalContentAlignment="Right"/>
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <CheckBox x:Name="BigWslBox" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Content="Kèm ổ ảo WSL / Docker trên C:"/>
                        <Button x:Name="BigScanButton" Margin="14,0,0,0" Style="{StaticResource PrimaryButton}" Click="BigScan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Quét"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BigStopButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                Click="BigStop_Click" IsEnabled="False" Content="Dừng"/>
                        <TextBlock x:Name="BigStatus" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Muted}"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                        <DataGrid x:Name="BigGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                                  BorderThickness="0" Background="White" RowBackground="White"
                                  AlternatingRowBackground="#FAFAFB" RowHeight="30" SelectionMode="Single"
                                  CanUserResizeRows="False" MouseDoubleClick="BigGrid_DoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizeText}" SortMemberPath="Length" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tên file" Binding="{Binding Name}" Width="230"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding TypeLabel}" Width="150"/>
                                <DataGridTextColumn Header="Sửa lần cuối" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="125"/>
                                <DataGridTextColumn Header="Thư mục" Binding="{Binding Folder}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="OpenLocation_Click"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Mở vị trí file"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="BigSummary" FontWeight="SemiBold" Text="Chỉ liệt kê, app không xoá file nào ở đây."/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Ổ ảo WSL (ext4.vhdx) không tự co lại khi xoá file bên trong. Thu nhỏ: chạy wsl --shutdown, rồi mở diskpart (admin): select vdisk file=&quot;…\ext4.vhdx&quot; → attach vdisk readonly → compact vdisk → detach vdisk."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
